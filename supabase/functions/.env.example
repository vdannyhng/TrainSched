# Lokale Edge-Function-Secrets. Kopieren nach supabase/functions/.env
# Muss zum Vault-Secret push_dispatch_secret passen (lokal setzt es supabase/seed.sql).
PUSH_DISPATCH_SECRET=local-dev-push-secret
# Optional: Expo Access Token, falls „Enhanced Push Security“ im Expo-Projekt aktiv ist
# EXPO_ACCESS_TOKEN=
