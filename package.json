    "@types/jest": "29.5.14",
    "@types/luxon": "^3.7.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
